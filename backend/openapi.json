  "components": {
    "schemas": {
      "Catalog": {
        "properties": {
          "data_directory": {
            "type": "string",
            "title": "Data Directory"
          },
          "counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "propertyNames": {
              "enum": [
                "skills",
                "mcp",
                "prompts",
                "models",
                "platforms"
              ]
            },
            "type": "object",
            "title": "Counts"
          },
          "platforms": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Platforms"
          }
        },
        "type": "object",
        "required": [
          "data_directory",
          "counts",
          "platforms"
        ],
        "title": "Catalog"
      },
      "CheckResult": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "limited",
              "failed"
            ],
            "title": "Status"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "resource_id": {
            "type": "string",
            "title": "Resource Id"
          },
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "cwd": {
            "type": "string",
            "title": "Cwd"
          },
          "checked_at": {
            "type": "string",
            "format": "date-time",
            "title": "Checked At"
          },
          "details": {
            "additionalProperties": true,
            "type": "object",
            "title": "Details"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "code",
          "message",
          "resource_id",
          "revision",
          "cwd",
          "checked_at"
        ],
        "title": "CheckResult"
      },
      "Draft": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": ""
          },
          "config": {
            "additionalProperties": true,
            "type": "object",
            "title": "Config"
          },
          "enabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Enabled"
          },
          "revision": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revision"
          },
          "clear_secrets": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Clear Secrets"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "config"
        ],
        "title": "Draft"
      },
      "EnabledChange": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          },
          "revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "enabled",
          "revision"
        ],
        "title": "EnabledChange"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImportOutcome": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "type": "string",
            "enum": [
              "saved",
              "skipped",
              "failed"
            ],
            "title": "Status"
          },
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "warning": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Warning"
          }
        },
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "title": "ImportOutcome"
      },
      "ImportPreview": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ImportPreviewItem"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "ImportPreview"
      },
      "ImportPreviewItem": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "conflict": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conflict"
          },
          "files": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Files"
          }
        },
        "type": "object",
        "required": [
          "name",
          "warnings",
          "files"
        ],
        "title": "ImportPreviewItem"
      },
      "ImportResults": {
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/ImportOutcome"
            },
            "type": "array",
            "title": "Results"
          }
        },
        "type": "object",
        "required": [
          "results"
        ],
        "title": "ImportResults"
      },
      "Resource": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "skills",
              "mcp",
              "prompts",
              "models",
              "platforms"
            ],
            "title": "Kind"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": ""
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "default": true
          },
          "revision": {
            "type": "integer",
            "title": "Revision",
            "default": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "config": {
            "additionalProperties": true,
            "type": "object",
            "title": "Config"
          },
          "secret_refs": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Secret Refs"
          },
          "last_check": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CheckResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "secret_fields": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Secret Fields",
            "readOnly": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "kind",
          "name",
          "config",
          "secret_fields"
        ],
        "title": "Resource"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
